---
import { getCollection } from 'astro:content';
import NotesLibrary from '../../components/NotesLibrary.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageSize = 10;
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const tags = [...new Set(notes.flatMap((note) => note.data.tags))];
const pageNotes = notes.slice(0, pageSize);
const totalPages = Math.max(1, Math.ceil(notes.length / pageSize));
---

<BaseLayout title="Notes - GatsbyH" description="Course notes, reading notes, and working drafts.">
  <main class="page-shell notes-page notes-library-page">
    <NotesLibrary notes={pageNotes} tags={tags} totalNotes={notes.length} currentPage={1} totalPages={totalPages} startIndex={0} />
  </main>
</BaseLayout>
