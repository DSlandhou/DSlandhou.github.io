---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id } }));
}

const slug = Astro.params.slug ?? '';
const entry = await getEntry('notes', slug);

if (!entry || entry.data.draft) {
  throw new Error('找不到这篇笔记。');
}

const { Content } = await render(entry);
const chineseTranslation = entry.data.translation?.trim() ?? '';
const chineseParagraphs = chineseTranslation
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const hasChineseTranslation = chineseParagraphs.length > 0;
const moreNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .filter((note) => note.id !== entry.id)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<BaseLayout title={`${entry.data.title} — Gatsby`} description={entry.data.description}>
  <main class="article-shell">
    <a class="back-link" href="/notes">← 所有笔记</a>
    <article class="article">
      <header class="article-header">
        <p class="eyebrow">{formatDate(entry.data.publishedAt)} · {entry.data.tags.join(' / ')}</p>
        <h1>{entry.data.title}</h1>
        <p class="article-description">{entry.data.description}</p>
        {hasChineseTranslation && (
          <div class="language-switch" role="group" aria-label="Note language">
            <span>Read in</span>
            <button class="is-active" type="button" data-note-language-toggle="en" aria-pressed="true">EN</button>
            <button type="button" data-note-language-toggle="zh" aria-pressed="false" lang="zh-CN">中文</button>
          </div>
        )}
      </header>
      <div class="prose note-language" data-note-language="en"><Content /></div>
      {hasChineseTranslation && (
        <div class="prose note-language note-language-zh" data-note-language="zh" lang="zh-CN" hidden>
          {chineseParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )}
    </article>

    {moreNotes.length > 0 && (
      <section class="more-notes">
        <p class="eyebrow">CONTINUE READING</p>
        {moreNotes.map((note) => <a href={`/notes/${note.id}`}>{note.data.title} <span>↗</span></a>)}
      </section>
    )}
  </main>
</BaseLayout>

{hasChineseTranslation && (
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-note-language-toggle]');
    const panels = document.querySelectorAll<HTMLElement>('[data-note-language]');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const language = button.dataset.noteLanguageToggle;
        buttons.forEach((item) => {
          const isActive = item.dataset.noteLanguageToggle === language;
          item.classList.toggle('is-active', isActive);
          item.setAttribute('aria-pressed', String(isActive));
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.noteLanguage !== language;
        });
      });
    });
  </script>
)}
